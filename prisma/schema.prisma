// ClothSE — Prisma schema
// Source of truth for business rules: SPEC.md §5 (entities) and §6 (rules).
// Money is integer VND (SPEC §7). Names are camelCase per Prisma convention;
// SPEC writes them snake_case for readability — same fields.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

/// SPEC §6.1 — the fulfilment axis. PENDING shows as "To Confirm".
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
  REFUND
}

/// SPEC §6.2 — cash on delivery only. Kept as an enum so a real gateway can be
/// added later without a schema change.
enum PaymentMethod {
  COD
}

/// SPEC §6.2 — the payment axis, independent of OrderStatus. Set by the status
/// flow (COMPLETED ⇒ PAID), never edited freely.
enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  addresses   Address[]
  orders      Order[]
  cartItems   CartItem[]
  favourites  Favourite[]
  resetTokens PasswordResetToken[]
}

model Address {
  id        Int     @id @default(autoincrement())
  label     String
  name      String
  phone     String
  line      String
  city      String
  isDefault Boolean @default(false)

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@index([userId])
}

/// SPEC §6.10 — store the HASH, never the raw token. 30-minute expiry, single use.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@index([userId])
}

// ─── Vocabulary ───────────────────────────────────────────────────────────────

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
  batches  Batch[]
}

/// Fixed at four (Tops, Bottoms, Accessories, Footwear). Seeded, no admin CRUD.
model Category {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  sizes    SizeOption[]
  types    ItemType[]
  products Product[]
  batches  Batch[]
}

/// SPEC §7 — item types mint SKUs (CSE-<code>-<seq>). Per-category vocabulary the admin
/// manages (Store Management → Loại món). A code is never edited once a product carries it.
model ItemType {
  id    Int    @id @default(autoincrement())
  /// Three uppercase letters, unique store-wide: HDY, TEE, SNK…
  code  String @unique
  label String

  category   Category  @relation(fields: [categoryId], references: [id])
  categoryId Int
  products   Product[]

  @@unique([categoryId, label])
}

/// SPEC §6.5 — the size vocabulary, per category. Deactivate, never delete:
/// a size referenced by an order must survive.
model SizeOption {
  id        Int     @id @default(autoincrement())
  label     String
  sortOrder Int
  active    Boolean @default(true)

  category   Category  @relation(fields: [categoryId], references: [id])
  categoryId Int
  variants   Variant[]
  batches    Batch[]

  @@unique([categoryId, label])
  @@index([categoryId, sortOrder])
}

/// SPEC §6.12 — free-form descriptive labels (Men, Women, Unisex, Limited…).
/// Badges are NOT tags; they are computed at read time (§6.11).
/// Service layer should trim + normalise case before insert.
model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  products ProductTag[]
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id           Int       @id @default(autoincrement())
  name         String
  sku          String    @unique
  price        Int
  salePrice    Int?
  /// SPEC §6.11 — when true, salePrice MUST be set and < price (service validates).
  onSale       Boolean   @default(false)
  description  String?
  /// SPEC §6.6 — display-only JSON: [{ label, value }]
  details      Json?
  modelFitNote String?
  /// SPEC §6.6 — display-only JSON keyed by size label. Phase 2.
  sizeGuide    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// SPEC §6.11 — set when a batch lands on a fully sold-out product.
  restockedAt  DateTime?

  brand      Brand    @relation(fields: [brandId], references: [id])
  brandId    Int
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  /// The type whose code is in the SKU. Nullable only for rows that predate the table.
  type       ItemType? @relation(fields: [typeId], references: [id])
  typeId     Int?

  tags       ProductTag[]
  images     ProductImage[]
  variants   Variant[]
  favourites Favourite[]

  @@index([categoryId])
  @@index([brandId])
  @@index([typeId])
  @@index([createdAt])
}

model ProductTag {
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     Int

  @@id([productId, tagId])
}

/// SPEC §6.9 — path only; the file lives in object storage. Lowest sortOrder is
/// the cover image.
model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  sortOrder Int
  alt       String?

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@index([productId, sortOrder])
}

/// SPEC §6.3 — stock lives here, per size, never on Product.
model Variant {
  id    Int @id @default(autoincrement())
  stock Int @default(0)

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    Int
  sizeOption   SizeOption @relation(fields: [sizeOptionId], references: [id])
  sizeOptionId Int

  batches    Batch[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@unique([productId, sizeOptionId])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

/// SPEC §6.4 / §6.5 — one batch = one size = one unit cost. variantId is null
/// while the goods are received but not yet listed ("unlinked"); category and
/// itemDescription carry the batch until Add Product links it.
model Batch {
  id              Int      @id @default(autoincrement())
  itemDescription String?
  receivedAt      DateTime @default(now())
  qtyReceived     Int
  qtyRemaining    Int
  unitCost        Int

  /// Brand, category and size are recorded at intake so an unlinked batch is
  /// self-describing; for a linked batch they must equal the variant's
  /// (service validates).
  brand        Brand      @relation(fields: [brandId], references: [id])
  brandId      Int
  category     Category   @relation(fields: [categoryId], references: [id])
  categoryId   Int
  sizeOption   SizeOption @relation(fields: [sizeOptionId], references: [id])
  sizeOptionId Int
  /// Restrict: a variant with batches cannot be deleted.
  variant      Variant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId    Int?

  /// FIFO consumes oldest receivedAt first.
  @@index([variantId, receivedAt])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

/// SPEC §6.1, §6.2, §6.8 — every money field and the ship_* fields are
/// SNAPSHOTS taken at checkout. Never recomputed.
model Order {
  id            Int           @id @default(autoincrement())
  /// Display form "#CSE-4417"; stored without the "#" prefix.
  code          String        @unique
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)

  subtotal    Int
  shippingFee Int
  total       Int

  shipName    String
  shipPhone   String
  shipAddress String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id])
  userId Int
  items  OrderItem[]

  @@index([userId, createdAt])
  @@index([status])
}

/// SPEC §6.4 — unitCogs is the FIFO cost captured at the moment stock is
/// deducted. Cannot be backfilled: consumed batches and changed costs make
/// it unrecoverable later.
model OrderItem {
  id        Int @id @default(autoincrement())
  qty       Int
  unitPrice Int
  unitCogs  Int

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  variant   Variant @relation(fields: [variantId], references: [id])
  variantId Int

  @@index([orderId])
}

// ─── Customer ─────────────────────────────────────────────────────────────────

/// Persistent cart (SPEC §3). One row per variant per user; qty adjusts.
model CartItem {
  id  Int @id @default(autoincrement())
  qty Int

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId Int

  @@unique([userId, variantId])
}

/// SPEC decision 17 — per product, not per size. notify drives restock and
/// sale emails (§6.10).
model Favourite {
  id        Int      @id @default(autoincrement())
  notify    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@unique([userId, productId])
}

/// SPEC §6.10 — newsletter signups are stored; no weekly sender is built.
model Subscriber {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  unsubscribeToken String   @unique
  createdAt        DateTime @default(now())
}
