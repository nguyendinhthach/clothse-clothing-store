# Copy to .env and fill in. .env is gitignored.

# PostgreSQL connection string — Neon (https://neon.tech), same database local and on Vercel.
# Keep sslmode=verify-full: pg warns on `require` because a future version will
# relax it to libpq semantics (no certificate check).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Optional; only `prisma migrate dev` uses it. Leave unset for hosted Postgres.
SHADOW_DATABASE_URL=""

# The one admin account, created/updated by `npm run db:seed`. Use a real password before deploying.
# (The demo customer for `npm run db:seed:demo` is fixed in prisma/seed.ts.)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# Auth.js — signs the session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Public origin, used in email links. On Vercel: https://<project>.vercel.app
APP_URL="http://localhost:3000"
# Server clock for "this month" / "this week" in Dashboard and Revenue (SPEC §7:
# store UTC, show Vietnam time). Set this on Vercel too — its default is UTC.
TZ="Asia/Ho_Chi_Minh"

# Gmail SMTP with an App Password (SPEC §6.10). Leave empty to print emails to the console instead of sending.
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ClothSE <your.gmail@gmail.com>"
# Where Contact-page messages land. Defaults to SMTP_USER.
CONTACT_TO=""

# Cloudinary (SPEC §6.9) — product images. Dashboard → API keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
