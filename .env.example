# Copy to .env and fill in. .env is gitignored.

# PostgreSQL connection string.
# Local dev without installing Postgres:  npx prisma dev   (prints both URLs to paste here)
# Cloud (free):                            https://neon.tech  or  npx create-db
DATABASE_URL="postgresql://user:password@localhost:5432/clothse?schema=public"
# Optional; only `prisma migrate dev` uses it. Leave unset for hosted Postgres.
SHADOW_DATABASE_URL=""

# Accounts created by `npx prisma db seed`. Change the passwords before deploying.
SEED_ADMIN_EMAIL="ngbon2220805@gmail.com"
SEED_ADMIN_PASSWORD="123456789"
SEED_USER_EMAIL="mai.tran@clothse.test"
SEED_USER_PASSWORD="clothse123"

# Auth.js — signs the session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Public origin, used in email links. On Vercel: https://<project>.vercel.app
APP_URL="http://localhost:3000"

# Gmail SMTP with an App Password (SPEC §6.10). Leave empty to print emails to the console instead of sending.
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ClothSE <your.gmail@gmail.com>"
